# DDF Configuration

# Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Database
DATABASE_URL=postgresql://ddf:ddf_password@localhost:5432/ddf_db
SQLALCHEMY_ECHO=false

# OpenFGA
OPENFGA_HOST=localhost
OPENFGA_PORT=8081
OPENFGA_STORE_ID=

# Cryptography
# ED25519 signing algorithm (cannot be changed in v0.1)
CRYPTO_ALGORITHM=Ed25519

# Logging
LOG_LEVEL=INFO

# Security
# Number of seconds timestamps are valid for request signatures
REQUEST_SIGNATURE_VALIDITY_SECONDS=300

# Development flag (NEVER use in production)
DEVELOPMENT_MODE=false

# v0.2 universal capability API
DDF_API_URL=http://127.0.0.1:8000
DDF_V01_COMPATIBILITY_ENABLED=false
DDF_CAPABILITY_TRUSTED_KEYS={}
DDF_EAT_TRUSTED_KEYS={}
DDF_MIN_POSTURE_SCORE=0.8
DDF_ATTESTATION_MAX_AGE_SECONDS=300

# Optional OpenFGA relationship checks
DDF_OPENFGA_ENABLED=false
DDF_OPENFGA_API_URL=http://localhost:8080
DDF_OPENFGA_STORE_ID=
DDF_OPENFGA_AUTHORIZATION_MODEL_ID=
