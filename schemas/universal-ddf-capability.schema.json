{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniversalDDFCapabilityAssertion",
  "type": "object",
  "additionalProperties": false,
  "required": ["grant_id", "issuer", "subject", "capability"],
  "properties": {
    "grant_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "description": "URI of delegating entity"
    },
    "subject": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "description": "URI of delegated actor"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_namespace",
        "target_resource",
        "operations",
        "constraints"
      ],
      "properties": {
        "target_namespace": {
          "type": "string",
          "minLength": 1
        },
        "target_resource": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["read", "write", "execute", "invoke", "delegate", "admin"]
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
